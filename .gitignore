# 시크릿 — 절대 커밋 금지
.env
.env.local
secrets/
*.credentials.json
token.json
client_secret*.json
# 배포 토큰. 원래는 ~/.config/k-money/ 에 있지만, 디버깅하다 저장소로
# 복사하는 일이 실제로 일어난다. 그 한 번이 공개 저장소로 나가면 끝이다.
deploy.json
*deploy.json

# 개인 금융 데이터 — 절대 커밋 금지
data/
# 시트를 그대로 뜬 테스트 픽스처 — 실거래 전량이 들어 있다
fixtures/
# 로컬에서 만든 산출물
out/
# 로컬 전용 메모 — 조사 결과·초안. 공개 문서는 docs/ 로 옮긴다
local_docs/
*.zip
*.xlsx
*.xls
*.csv

# Node
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
# 배포 빌드 산물 (scripts/build-deploy.js)
build/
