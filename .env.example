# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env && chmod 600 .env
#
# ⚠️ .env 는 .gitignore 에 등록돼 있습니다. 절대 커밋하지 마세요.
# ⚠️ 에이전트에게 키 값을 불러주지 마세요 — 직접 편집기로 붙여넣으세요.

# ── Gmail (뱅크샐러드 내보내기 메일 수신) ─────────────────────────
# Google Cloud Console 에서 발급한 OAuth 클라이언트 JSON 파일 경로.
# docs/setup-gmail.md 참고.
GOOGLE_CLIENT_SECRET_FILE=./secrets/client_secret.json

# OAuth 토큰 캐시 저장 위치 (최초 1회 브라우저 동의 후 자동 생성)
GOOGLE_TOKEN_FILE=./secrets/gmail_token.json

# ── 뱅크샐러드 내보내기 ────────────────────────────────────────────
# 내보내기 zip 의 비밀번호. 뱅샐 앱에서 직접 정한 값.
BANKSALAD_ZIP_PASSWORD=

# 첨부를 찾을 Gmail 검색 쿼리. 기본값으로 못 찾으면 조정하세요.
BANKSALAD_GMAIL_QUERY=has:attachment filename:zip (뱅크샐러드 OR banksalad)

# ── 작업 디렉토리 ──────────────────────────────────────────────────
MONEY_AUDIT_DATA_DIR=./data
