      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git describe:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git push origin main)",
      "Bash(git push origin v*)",
      "Bash(gh auth status)",
      "Bash(gh release create:*)",
      "Bash(gh run list:*)"
    ]
